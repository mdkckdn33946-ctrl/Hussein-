<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>إلى حسون | Miku World 💙✨</title>
    
    <!-- Three.js Visual Engine -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <!-- Canvas Confetti -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800;900&family=Mplus+1p:wght@800&display=swap" rel="stylesheet">

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Tajawal', sans-serif;
            -webkit-tap-highlight-color: transparent;
            user-select: none;
        }

        body, html {
            width: 100%;
            height: 100%;
            overflow: hidden;
            background-color: #030712;
            color: #ffffff;
        }

        /* 3D WebGL Background Container */
        #canvas-container {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 1;
            pointer-events: none;
        }

        /* Start Overlay Screen for Audio Unblock */
        .intro-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(3, 7, 18, 0.95);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            z-index: 100;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            transition: opacity 0.8s ease, visibility 0.8s ease;
            padding: 20px;
            text-align: center;
        }

        .intro-overlay.hidden {
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
        }

        .miku-logo {
            font-family: 'Mplus 1p', sans-serif;
            font-size: 38px;
            color: #00f3ff;
            text-shadow: 0 0 20px rgba(0, 243, 255, 0.8), 0 0 40px rgba(138, 43, 226, 0.6);
            margin-bottom: 15px;
            letter-spacing: 2px;
        }

        .start-btn {
            background: linear-gradient(135deg, #00f3ff 0%, #8a2be2 100%);
            color: #ffffff;
            border: none;
            padding: 18px 45px;
            font-size: 18px;
            font-weight: 800;
            border-radius: 50px;
            cursor: pointer;
            box-shadow: 0 0 30px rgba(0, 243, 255, 0.5);
            transition: all 0.3s ease;
            animation: pulseBtn 2s infinite alternate;
        }

        @keyframes pulseBtn {
            0% { transform: scale(1); box-shadow: 0 0 25px rgba(0, 243, 255, 0.4); }
            100% { transform: scale(1.08); box-shadow: 0 0 45px rgba(138, 43, 226, 0.8); }
        }

        /* Viewport Frame */
        .viewport-wrapper {
            position: relative;
            z-index: 10;
            width: 100%;
            height: 100%;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }

        /* Glass Cyber Card */
        .cyber-card {
            width: 100%;
            max-width: 440px;
            background: rgba(10, 15, 30, 0.75);
            backdrop-filter: blur(25px);
            -webkit-backdrop-filter: blur(25px);
            border: 1px solid rgba(0, 243, 255, 0.3);
            border-radius: 36px;
            padding: 35px 28px;
            text-align: center;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.8),
                        0 0 40px rgba(0, 243, 255, 0.2);
            position: relative;
            overflow: hidden;
        }

        /* Hatsune Miku Avatar Styling */
        .miku-avatar-wrapper {
            position: relative;
            width: 130px;
            height: 130px;
            margin: 0 auto 20px;
        }

        .miku-frame {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            padding: 4px;
            background: linear-gradient(135deg, #00f3ff, #8a2be2, #ff007f);
            box-shadow: 0 0 35px rgba(0, 243, 255, 0.6);
            animation: glowRotate 4s linear infinite;
        }

        @keyframes glowRotate {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        .miku-img {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            object-fit: cover;
            border: 3px solid #0a0f1e;
        }

        /* Content Text Area */
        .content-area {
            min-height: 190px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            transition: opacity 0.35s ease, transform 0.35s ease;
        }

        .content-area.fade {
            opacity: 0;
            transform: translateY(8px);
        }

        .title-text {
            font-size: 25px;
            font-weight: 900;
            background: linear-gradient(135deg, #00f3ff 0%, #d8b4fe 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 12px;
            line-height: 1.3;
        }

        .msg-text {
            font-size: 16px;
            line-height: 1.8;
            color: #e0f2fe;
            font-weight: 500;
            margin-bottom: 25px;
        }

        /* Buttons */
        .btn-box {
            display: flex;
            gap: 12px;
            justify-content: center;
            width: 100%;
            flex-wrap: wrap;
        }

        .action-btn {
            background: linear-gradient(135deg, #00f3ff 0%, #7c3aed 100%);
            color: #ffffff;
            border: none;
            padding: 15px 32px;
            font-size: 16px;
            font-weight: 800;
            border-radius: 50px;
            cursor: pointer;
            box-shadow: 0 8px 25px rgba(0, 243, 255, 0.4);
            transition: all 0.3s ease;
            width: 100%;
            max-width: 240px;
        }

        .action-btn:hover {
            transform: translateY(-2px) scale(1.02);
            box-shadow: 0 12px 30px rgba(124, 58, 237, 0.6);
        }

        /* Progress Dots */
        .dots-row {
            display: flex;
            justify-content: center;
            gap: 8px;
            margin-top: 25px;
        }

        .dot-node {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.2);
            transition: all 0.4s ease;
        }

        .dot-node.active {
            width: 28px;
            border-radius: 10px;
            background: #00f3ff;
            box-shadow: 0 0 12px #00f3ff;
        }

        .counter-val {
            font-size: 44px;
            font-weight: 900;
            background: linear-gradient(135deg, #00f3ff, #c084fc, #ff007f);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin: 12px 0;
        }
    </style>
</head>
<body>

    <!-- Intro Overlay Screen for Autoplay -->
    <div class="intro-overlay" id="introOverlay">
        <div class="miku-logo">初音ミク WORLD</div>
        <p style="color: #94a3b8; font-size: 16px; margin-bottom: 30px;">رسالة خاصة وإهداء محضر لحسون 💙✨</p>
        <button class="start-btn" onclick="startExperience()">دخول العالم 🎧</button>
    </div>

    <!-- 3D Background Canvas -->
    <div id="canvas-container"></div>

    <!-- Main Viewport -->
    <div class="viewport-wrapper">
        <div class="cyber-card">
            
            <!-- Miku Anime Avatar -->
            <div class="miku-avatar-wrapper">
                <div class="miku-frame">
                    <!-- High Quality Official Hatsune Miku Image -->
                    <img class="miku-img" src="https://images.alphacoders.com/836/836814.png" alt="Hatsune Miku">
                </div>
            </div>

            <div class="content-area" id="contentArea"></div>
            <div class="dots-row" id="dotsRow"></div>
        </div>
    </div>

    <script>
        // =========================================================
        // 1. THREE.JS 3D SCENE SETUP (SAKURA & CYBER SPACE)
        // =========================================================
        const container = document.getElementById('canvas-container');
        const scene = new THREE.Scene();
        scene.fog = new THREE.FogExp2(0x030712, 0.02);

        const camera = new THREE.PerspectiveCamera(65, window.innerWidth / window.innerHeight, 0.1, 1000);
        camera.position.z = 22;

        const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
        renderer.setSize(window.innerWidth, window.innerHeight);
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
        container.appendChild(renderer.domElement);

        // Lighting
        const ambientLight = new THREE.AmbientLight(0xffffff, 0.7);
        scene.add(ambientLight);

        const mikuLight = new THREE.PointLight(0x00f3ff, 4, 50);
        mikuLight.position.set(10, 10, 10);
        scene.add(mikuLight);

        const purpleLight = new THREE.PointLight(0x8a2be2, 3, 50);
        purpleLight.position.set(-10, -10, -10);
        scene.add(purpleLight);

        // Floating Sakura Petals
        const sakuraCount = 150;
        const sakuraGeo = new THREE.BufferGeometry();
        const sakuraPos = new Float32Array(sakuraCount * 3);

        for (let i = 0; i < sakuraCount * 3; i += 3) {
            sakuraPos[i] = (Math.random() - 0.5) * 50;
            sakuraPos[i+1] = (Math.random() - 0.5) * 50;
            sakuraPos[i+2] = (Math.random() - 0.5) * 30;
        }

        sakuraGeo.setAttribute('position', new THREE.BufferAttribute(sakuraPos, 3));
        const sakuraMat = new THREE.PointsMaterial({
            size: 0.35,
            color: 0x00f3ff,
            transparent: true,
            opacity: 0.8
        });
        const sakuraSystem = new THREE.Points(sakuraGeo, sakuraMat);
        scene.add(sakuraSystem);

        const clock = new THREE.Clock();
        function animate() {
            requestAnimationFrame(animate);
            const elapsedTime = clock.getElapsedTime();

            sakuraSystem.rotation.y = elapsedTime * 0.03;
            sakuraSystem.position.y = Math.sin(elapsedTime * 0.5) * 1.5;

            renderer.render(scene, camera);
        }
        animate();

        window.addEventListener('resize', () => {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        });

        // =========================================================
        // 2. RUSSIAN SONG SYNTHESIZER (Луна не знает пути)
        // =========================================================
        let audioCtx;
        function playRussianMelody() {
            const AudioContext = window.AudioContext || window.webkitAudioContext;
            audioCtx = new AudioContext();

            // Notes for "Luna ne znaet puti"
            const notes = [
                { f: 329.63, d: 0.4 }, { f: 392.00, d: 0.4 }, { f: 440.00, d: 0.4 }, { f: 392.00, d: 0.4 },
                { f: 329.63, d: 0.6 }, { f: 293.66, d: 0.4 }, { f: 261.63, d: 0.6 }, { f: 293.66, d: 0.8 }
            ];

            let time = audioCtx.currentTime + 0.1;

            function playLoop() {
                notes.forEach(note => {
                    const osc = audioCtx.createOscillator();
                    const gain = audioCtx.createGain();

                    osc.type = 'triangle';
                    osc.frequency.setValueAtTime(note.f, time);

                    gain.gain.setValueAtTime(0.2, time);
                    gain.gain.exponentialRampToValueAtTime(0.001, time + note.d);

                    osc.connect(gain);
                    gain.connect(audioCtx.destination);

                    osc.start(time);
                    osc.stop(time + note.d);

                    time += note.d + 0.05;
                });
                setTimeout(playLoop, (time - audioCtx.currentTime) * 1000);
            }

            playLoop();
        }

        function startExperience() {
            document.getElementById('introOverlay').classList.add('hidden');
            playRussianMelody();
        }

        // =========================================================
        // 3. STEP CONTENT LOGIC
        // =========================================================
        const steps = [
            {
                title: "هلوو بالضلع حسون ✨",
                message: "عندي إهداء خاص إلك بتصميم أنمي وموسيقى سينمائية.. جاهز تشووفها؟ 💙",
                btnText: "شنو هي؟ 🥺"
            },
            {
                title: "أطلق وأعز صديق 👑",
                message: "الحياة أهدتني شخصاً حنوناً وجميلاً بجمالك.. ويا بختي بقلبك الطيب والرقيق يا حسوني 💎✨",
                btnText: "التالي 💕"
            },
            {
                title: "سؤال صريح حسوني..",
                message: "معقولة تحبني وتعتبرني أوفى صديق مثل ما أني أعتبرك أغلى إنسان بصحبتي ودنيتي؟ 🙈❤️",
                btnText: "اي أكيد أعزك! 💖"
            },
            {
                title: "وأني أعزك وأغليك أكثر! ❤️",
                message: "لو تدري شكد وجودك بالدنيا ينطي طاقة إيجابية.. جان عرفت أنك أجمل شيء بصحبتي ودنيتي كلها 👑✨",
                btnText: "شوف نسبة غلاك 😍"
            },
            {
                title: "نسبة معزتك وغلاك يا حسون:",
                isFinal: true
            }
        ];

        let currentStep = 0;

        function renderDots() {
            const container = document.getElementById('dotsRow');
            container.innerHTML = '';
            steps.forEach((_, idx) => {
                const dot = document.createElement('div');
                dot.className = `dot-node ${idx === currentStep ? 'active' : ''}`;
                container.appendChild(dot);
            });
        }

        function showStep(index) {
            const step = steps[index];
            const area = document.getElementById('contentArea');

            area.classList.add('fade');

            setTimeout(() => {
                if (step.isFinal) {
                    area.innerHTML = `
                        <div class="title-text">${step.title}</div>
                        <div class="counter-val" id="counter">0%</div>
                        <div class="msg-text" style="margin-bottom:15px;">معزتك لا نهائية يا حسوني الغالي 🌸💖</div>
                        <div class="btn-box">
                            <button class="action-btn" onclick="restart()">إعادة العرض 🔄</button>
                        </div>
                    `;
                    animateCounter();
                    triggerConfetti();
                } else {
                    area.innerHTML = `
                        <div class="title-text">${step.title}</div>
                        <div class="msg-text">${step.message}</div>
                        <div class="btn-box">
                            <button class="action-btn" onclick="nextStep()">${step.btnText}</button>
                        </div>
                    `;
                }

                area.classList.remove('fade');
                renderDots();
            }, 300);
        }

        function nextStep() {
            if (currentStep < steps.length - 1) {
                currentStep++;
                showStep(currentStep);
            }
        }

        function restart() {
            currentStep = 0;
            showStep(currentStep);
        }

        function animateCounter() {
            let count = 0;
            const target = 1000000;
            const counterEl = document.getElementById('counter');
            const timer = setInterval(() => {
                count += 28000;
                if (count >= target) {
                    counterEl.textContent = "1,000,000% ∞";
                    clearInterval(timer);
                } else {
                    counterEl.textContent = `${count.toLocaleString()}%`;
                }
            }, 30);
        }

        function triggerConfetti() {
            confetti({
                particleCount: 150,
                spread: 80,
                origin: { y: 0.6 },
                colors: ['#00f3ff', '#8a2be2', '#ff007f']
            });
        }

        showStep(0);
    </script>
</body>
</html>
